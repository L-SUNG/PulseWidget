<UserControl x:Class="PulseWidget.WidgetStrip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI, Malgun Gothic" UseLayoutRounding="True">
  <Border x:Name="Surface" Background="{DynamicResource Pulse.SurfaceBackground}" BorderBrush="{DynamicResource Pulse.Border}" BorderThickness="1" CornerRadius="{DynamicResource Pulse.WidgetRadius}" Padding="9,1" Cursor="Hand" ToolTip="클릭: 상세 보기 · 우클릭: 위치와 설정">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="1"/><ColumnDefinition Width="236"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><TextBlock Text="OpenAI" Foreground="{DynamicResource Pulse.OpenAI}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="CodexStatus" Margin="7,0,0,0" Foreground="{DynamicResource Pulse.Muted}" FontSize="10"/></StackPanel>
        <TextBlock x:Name="CodexNumbers" Text="주간 — / 잔여 —" Foreground="{DynamicResource Pulse.Text}" FontSize="11" Margin="0,1,0,0"/>
        <ProgressBar x:Name="CodexWeekBar" Minimum="0" Maximum="100" Height="3" Margin="0,2,9,0" Foreground="{DynamicResource Pulse.OpenAI}" Style="{StaticResource Pulse.Meter}"/>
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource Pulse.Border}" Margin="0,4"/>
      <StackPanel Grid.Column="2" Margin="11,0,0,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><TextBlock Text="Claude" Foreground="{DynamicResource Pulse.Claude}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ClaudeStatus" Margin="7,0,0,0" Foreground="{DynamicResource Pulse.Muted}" FontSize="10"/></StackPanel>
        <TextBlock x:Name="ClaudeNumbers" Text="주간 — / 잔여 — · 5h —" Foreground="{DynamicResource Pulse.Text}" FontSize="11" Margin="0,1,0,0"/>
        <Grid Margin="0,2,9,0" Height="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ProgressBar x:Name="ClaudeWeekBar" Minimum="0" Maximum="100" Foreground="{DynamicResource Pulse.Claude}" Style="{StaticResource Pulse.Meter}"/>
          <ProgressBar x:Name="ClaudeFiveBar" Grid.Column="2" Minimum="0" Maximum="100" Foreground="{DynamicResource Pulse.Claude}" Style="{StaticResource Pulse.Meter}"/>
        </Grid>
      </StackPanel>
      <Border Grid.Column="3" Background="{DynamicResource Pulse.Border}" Margin="0,4"/>
      <StackPanel Grid.Column="4" Margin="11,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="CpuNumber" Text="CPU  —" Foreground="{DynamicResource Pulse.Secondary}" FontSize="11"/>
        <TextBlock x:Name="MemNumber" Text="MEM  —" Foreground="{DynamicResource Pulse.Secondary}" FontSize="11"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
